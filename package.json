{
  "name": "dsh-qq-card",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Floating clickable card for pending ask_user_question prompts across every session.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "assets",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
